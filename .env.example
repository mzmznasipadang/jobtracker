ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# from: echo "your password" | npm run -s hash-password (format scrypt:salt:hash, no "$")
ADMIN_PASSWORD_HASH=
APP_SECRET=
# production sets https://tracking.naspadstudio.id
APP_URL=http://localhost:3000
DB_PATH=./data/jobtracker.db
DRY_RUN=true
TZ=Asia/Jakarta
# Owner of the existing database; set before enabling multi-account login.
OWNER_GOOGLE_EMAIL=owner@example.com

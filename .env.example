ANTHROPIC_API_KEY=
# Optional: configure to enable OpenAI in owner AI settings.
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate once with openssl rand -hex 32; preserve it when upgrading (encrypts Gmail tokens).
APP_SECRET=
# production sets https://tracking.naspadstudio.id
APP_URL=http://localhost:3000
DB_PATH=./data/jobtracker.db
DRY_RUN=true
TZ=Asia/Jakarta
# Owner of the existing database; set before enabling multi-account login.
OWNER_GOOGLE_EMAIL=owner@example.com

# Public Google registration; false/missing allows only previously approved accounts.
OPEN_BETA_ENABLED=false
